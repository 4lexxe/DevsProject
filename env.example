# ============================================
# Configuración de Base de Datos
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devsproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# ============================================
# Configuración del Servidor
# ============================================
NODE_ENV=production
PORT=3000
SERVER_PORT=3000

# ============================================
# URLs de los Clientes (REQUERIDAS)
# ============================================
# URL completa donde se servirá la aplicación frontend principal
CLIENT_URL=http://localhost:5173

# URL completa donde se servirá el dashboard de administración
ADMIN_CLIENT_URL=http://localhost:5175

# URLs adicionales para CORS (separadas por comas, opcional)
# ADDITIONAL_CORS_ORIGINS=http://localhost:5174,https://otro-dominio.com

# ============================================
# URLs de la API (REQUERIDAS para frontend)
# ============================================
# URL completa de la API backend (usada por los frontends)
VITE_API_URL=http://localhost:3000/api

# URL del backend para Socket.IO (opcional, usa VITE_API_URL si no se define)
VITE_BACKEND_URL=http://localhost:3000

# ============================================
# Seguridad (REQUERIDO)
# ============================================
# Genera una clave secreta segura para las sesiones
# Puedes usar: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ============================================
# OAuth - GitHub (Opcional)
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# OAuth - Discord (Opcional)
# ============================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ============================================
# MercadoPago (Opcional)
# ============================================
MERCADOPAGO_ACCESS_TOKEN=

# ============================================
# Google Cloud (Opcional)
# ============================================
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# Puertos de los Servicios Frontend
# ============================================
APP_PORT=5173
ADMIN_PORT=5175

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Copia este archivo a .env y completa los valores
# 2. CLIENT_URL, ADMIN_CLIENT_URL y VITE_API_URL son REQUERIDAS
# 3. SESSION_SECRET debe ser una clave secreta segura
# 4. Para producción, usa URLs completas con protocolo (http:// o https://)
# 5. Las variables VITE_* se inyectan en build time en los frontends
